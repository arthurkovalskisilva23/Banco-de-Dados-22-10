-- ATIVIDADE 8
-- Nome do cliente, produto e valor dos pedidos


SELECT
    c.nome AS cliente,
    ip.produto,
    ip.quantidade,
    ip.preco_unitario AS valor_unitario,
    (ip.quantidade * ip.preco_unitario) AS valor_total
FROM clientes c
INNER JOIN pedidos p
    ON c.id_cliente = p.id_cliente
INNER JOIN itens_pedido ip
    ON p.id_pedido = ip.id_pedido
ORDER BY c.nome;

-- ATIVIDADE 9
-- Mostrar todos os pedidos, inclusive
-- aqueles que não possuem pedidos relacionados

SELECT
    c.nome AS cliente,
    p.id_pedido,
    p.status,
    p.total_pedido
FROM clientes c
LEFT JOIN pedidos p
    ON c.id_cliente = p.id_cliente
ORDER BY c.nome;


-- ATIVIDADE 10
-- Mostrar todos os pedidos e, quando existir,
-- o nome do cliente relacionado

SELECT
    p.id_pedido,
    p.status,
    p.total_pedido,
    c.nome AS cliente
FROM pedidos p
LEFT JOIN clientes c
    ON p.id_cliente = c.id_cliente
ORDER BY p.id_pedido;
