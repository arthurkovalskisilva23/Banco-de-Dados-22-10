SELECT 
    p.id_pedido AS "Nº Pedido",
    c.nome AS "Cliente",
    c.cidade AS "Cidade",
    p.status AS "Status do Pedido",
    p.total_pedido AS "Total do Pedido"
FROM clientes c
JOIN pedidos p ON c.id_cliente = p.id_cliente
ORDER BY p.id_pedido;


SELECT 
    ip.id_pedido AS "Nº Pedido",
    ip.produto AS "Produto Comprado",
    ip.quantidade AS "Qtd",
    ip.preco_unitario AS "Preço Unit."
FROM itens_pedido ip
ORDER BY ip.id_pedido;




